### Create Client
# Creates a new client. The ID is a UUID generated by Postgres (gen_random_uuid()).
# Body fields:
#   name  (string)  client name
# Returns 201 with { message, client } where client = { id, name, created_at, version }.
# Errors: 400 if the body is malformed JSON or has unknown fields.
# NOTE: the Location header is built in the handler but not sent yet
#       (writeJSON receives nil instead of headers).
# See: cmd/api/clients.go createClient
# @name createClient
POST {{host}}/v1/api/clients
Content-Type: application/json

{
  "name": "Client to delete"
}

### Get Client by ID
# Returns a single client by its UUID.
# Path params:
#   id  (uuid)  client ID
# Returns 200 with { client }.
# Errors: 404 if no client matches the ID.
#         An ID that is not a valid UUID currently ends up as a 500 (Postgres rejects the cast).
# See: cmd/api/clients.go showClientHandler
# @name showClient
GET {{host}}/v1/api/clients/91653ea7-68c5-4c45-a820-af40807af598

### List Clients
# Returns a paginated list of clients.
# Query params (all optional):
#   name       (string)  full-text search on the name (to_tsvector 'simple'); empty = no filter
#   page       (int)     page number, 1 - 10,000,000 (default 1)
#   page_size  (int)     results per page, 1 - 100 (default 20)
#   sort       (string)  id | name (default id); a "-" prefix means DESC (e.g. -name)
# Returns 200 with { clients, metadata } where metadata =
#   { current_page, page_size, first_page, last_page, total_records }
#   (metadata is {} when there are no results).
# Errors: 422 with a field -> message map if a filter fails validation.
# See: cmd/api/clients.go listClientsHandler, internal/api/data/filters.go
# @name listClients
GET {{host}}/v1/api/clients

### Update Client
# Updates and returns a client.
# Path params:
#   id  (uuid)  client ID
# Returns 200 with { client }.
# Errors: 404 if no client matches the ID.
#         An ID that is not a valid UUID currently ends up as a 500 (Postgres rejects the cast).
# See: cmd/api/clients.go updateClientHandler, internal/api/data/filters.go
# @name updateClient
PATCH {{host}}/v1/api/clients/33488f41-7b8d-4003-aa9f-05938e331a4a

{
    "name": "Client 2"
}

### Delete Client
# Returns a paginated list of clients.
# Path params:
#   id  (uuid)  client ID
# Returns 200 with { message: "client sucessfully deleted" }.
# Errors: 404 if no client matches the ID.
#         An ID that is not a valid UUID currently ends up as a 500 (Postgres rejects the cast).
# See: cmd/api/clients.go deleteClientHandler, internal/api/data/filters.go
# @name deleteClient
DELETE {{host}}/v1/api/clients/555f936a-4252-4ff5-9eed-531db1f001a7
